# Copy to .env and fill in. Never commit the real .env file.

# --- PostgreSQL ---
POSTGRES_DB=crustcrunch
POSTGRES_USER=crustcrunch
POSTGRES_PASSWORD=sk_hu0FssfG45AHtLrizFo1Q

# --- Backend ---
# Generate with: openssl rand -base64 48   (must be at least 32 bytes)
JWT_SECRET=r8F2kL9mQ4xR7vN1pT6yW3zB5cD0hJ8s
JWT_EXPIRATION_MINUTES=1440
# Comma-separated list of browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081

# First admin + kitchen accounts (created on first start only if they don't exist)
ADMIN_EMAIL=admin@crustandcrunch.example
ADMIN_PASSWORD=admin@123
KITCHEN_EMAIL=kitchen@crustandcrunch.example
KITCHEN_PASSWORD=kitchen@123

# Generate 60 days of sample orders/reviews on an empty database (true/false)
DEMO_DATA=true

# Pricing
TAX_RATE=0.08
DELIVERY_FEE=2.99
FREE_DELIVERY_THRESHOLD=35.00
MIN_DELIVERY_ORDER=10.00
CURRENCY=USD
# Use the built-in simulated online payment gateway (no real charges)
PAYMENTS_SIMULATED=true

# Restaurant
RESTAURANT_TIMEZONE=UTC
RESTAURANT_PHONE=+1 (555) 014-2277
RESTAURANT_EMAIL=hello@crustandcrunch.example
RESTAURANT_ADDRESS=221 Ember Street, Springfield

# --- Ports on the host ---
FRONTEND_PORT=8081
BACKEND_PORT=8080
